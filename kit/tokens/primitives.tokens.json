{
  "space": {
    "0": {
      "$value": "0px"
    },
    "1": {
      "$value": "4px"
    },
    "2": {
      "$value": "8px"
    },
    "3": {
      "$value": "12px"
    },
    "4": {
      "$value": "16px"
    },
    "5": {
      "$value": "20px"
    },
    "6": {
      "$value": "24px"
    },
    "7": {
      "$value": "28px"
    },
    "8": {
      "$value": "32px"
    },
    "9": {
      "$value": "36px"
    },
    "10": {
      "$value": "40px"
    },
    "11": {
      "$value": "44px"
    },
    "12": {
      "$value": "48px"
    },
    "$type": "dimension",
    "$description": "4px grid, step n = n x 4px."
  },
  "radius": {
    "$type": "dimension",
    "none": {
      "$value": "0px"
    },
    "sm": {
      "$value": "2px"
    },
    "md": {
      "$value": "4px"
    },
    "lg": {
      "$value": "8px"
    },
    "xl": {
      "$value": "12px"
    },
    "full": {
      "$value": "9999px"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Inter",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "monospace"
        ]
      }
    },
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": "12px"
      },
      "sm": {
        "$value": "14px"
      },
      "md": {
        "$value": "16px"
      },
      "lg": {
        "$value": "18px"
      },
      "xl": {
        "$value": "20px"
      },
      "2xl": {
        "$value": "24px"
      },
      "3xl": {
        "$value": "30px"
      },
      "4xl": {
        "$value": "36px"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.25
      },
      "normal": {
        "$value": 1.5
      },
      "relaxed": {
        "$value": 1.75
      }
    }
  },
  "duration": {
    "50": {
      "$value": "50ms"
    },
    "150": {
      "$value": "150ms"
    },
    "200": {
      "$value": "200ms"
    },
    "300": {
      "$value": "300ms"
    },
    "400": {
      "$value": "400ms"
    },
    "$type": "duration"
  },
  "easing": {
    "$type": "cubicBezier",
    "$description": "Carbon productive curves.",
    "standard": {
      "$value": [
        0.2,
        0,
        0.38,
        0.9
      ]
    },
    "enter": {
      "$value": [
        0,
        0,
        0.38,
        0.9
      ]
    },
    "exit": {
      "$value": [
        0.2,
        0,
        1,
        0.9
      ]
    }
  },
  "shadow": {
    "1": {
      "$value": {
        "color": "rgba(17, 24, 39, 0.10)",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "3px",
        "spread": "0px"
      }
    },
    "2": {
      "$value": [
        {
          "color": "rgba(17, 24, 39, 0.10)",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "6px",
          "spread": "-1px"
        },
        {
          "color": "rgba(17, 24, 39, 0.06)",
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "4px",
          "spread": "-2px"
        }
      ]
    },
    "$type": "shadow",
    "dark": {
      "1": {
        "$value": {
          "color": "rgba(0, 0, 0, 0.40)",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "3px",
          "spread": "0px"
        }
      },
      "2": {
        "$value": [
          {
            "color": "rgba(0, 0, 0, 0.50)",
            "offsetX": "0px",
            "offsetY": "4px",
            "blur": "6px",
            "spread": "-1px"
          },
          {
            "color": "rgba(0, 0, 0, 0.35)",
            "offsetX": "0px",
            "offsetY": "2px",
            "blur": "4px",
            "spread": "-2px"
          }
        ]
      },
      "$description": "Dark-theme shadows: stronger and blacker, because a dark surface hides a soft shadow. Elevation in dark also comes from a lighter raised surface."
    }
  },
  "z": {
    "$type": "number",
    "base": {
      "$value": 0
    },
    "dropdown": {
      "$value": 1000
    },
    "sticky": {
      "$value": 1100
    },
    "overlay": {
      "$value": 1200
    },
    "modal": {
      "$value": 1300
    },
    "popover": {
      "$value": 1400
    },
    "toast": {
      "$value": 1500
    }
  }
}
