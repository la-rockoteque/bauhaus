{
  "font": {
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": "12px"
      },
      "sm": {
        "$value": "14px"
      },
      "md": {
        "$value": "16px"
      },
      "lg": {
        "$value": "18px"
      },
      "xl": {
        "$value": "24px"
      },
      "2xl": {
        "$value": "36px"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.25
      },
      "normal": {
        "$value": 1.5
      }
    }
  },
  "text": {
    "body": {
      "family": {
        "$type": "fontFamily",
        "$value": "{font.sans}"
      },
      "size": {
        "$type": "dimension",
        "$value": "{font.size.sm}"
      },
      "weight": {
        "$type": "fontWeight",
        "$value": "{font.weight.regular}"
      },
      "line-height": {
        "$type": "number",
        "$value": "{font.line-height.normal}"
      }
    },
    "caption": {
