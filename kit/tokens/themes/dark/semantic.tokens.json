{
  "color": {
    "$type": "color",
    "text": {
      "default": {
        "$value": "{color.gray.50}"
      },
      "muted": {
        "$value": "{color.gray.400}"
      },
      "disabled": {
        "$value": "{color.gray.600}"
      },
      "inverse": {
        "$value": "{color.gray.900}"
      },
      "link": {
        "$value": "{color.blue.300}"
      },
      "on-accent": {
        "$value": "{color.gray.900}"
      }
    },
    "surface": {
      "default": {
        "$value": "{color.gray.900}"
      },
      "soft": {
        "$value": "{color.gray.800}"
      },
      "raised": {
        "$value": "{color.gray.800}"
      },
      "sunken": {
        "$value": "{color.black}"
      },
      "inverse": {
        "$value": "{color.gray.50}"
      }
    },
    "border": {
      "subtle": {
        "$value": "{color.gray.800}"
      },
      "default": {
        "$value": "{color.gray.700}"
      },
      "strong": {
        "$value": "{color.gray.400}"
      }
    },
    "accent": {
      "default": {
        "$value": "{color.blue.400}"
      },
      "hover": {
        "$value": "{color.blue.300}"
      },
      "active": {
        "$value": "{color.blue.200}"
      },
      "subtle": {
        "$value": "{color.blue.900}"
      }
    },
    "status": {
      "ready": {
        "text": {
          "$value": "{color.green.300}"
        },
        "surface": {
          "$value": "{color.green.900}"
        },
        "border": {
          "$value": "{color.green.500}"
        }
      },
      "warning": {
        "text": {
          "$value": "{color.amber.300}"
        },
        "surface": {
          "$value": "{color.amber.900}"
        },
        "border": {
          "$value": "{color.amber.500}"
        }
      },
      "error": {
        "text": {
          "$value": "{color.red.300}"
        },
        "surface": {
          "$value": "{color.red.900}"
        },
        "border": {
          "$value": "{color.red.400}"
        }
      },
      "neutral": {
        "text": {
          "$value": "{color.gray.200}"
        },
        "surface": {
          "$value": "{color.gray.800}"
        },
        "border": {
          "$value": "{color.gray.400}"
        }
      }
    }
  }
}
