{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Inter",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "monospace"
        ]
      }
    },
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": "12px"
      },
      "sm": {
        "$value": "14px"
      },
      "md": {
        "$value": "16px"
      },
      "xl": {
        "$value": "24px"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.25
      },
      "normal": {
        "$value": 1.5
      }
    }
  },
  "text": {
    "body": {
      "size": {
        "$value": "{font.size.md}",
        "$type": "dimension"
      },
      "weight": {
        "$value": "{font.weight.regular}",
        "$type": "fontWeight"
      },
      "line-height": {
        "$value": "{font.line-height.normal}",
        "$type": "number"
      }
    },
    "caption": {
      "size": {
        "$value": "{font.size.sm}",
        "$type": "dimension"
      },
      "weight": {
        "$value": "{font.weight.regular}",
        "$type": "fontWeight"
      },
      "line-height": {
        "$value": "{font.line-height.normal}",
        "$type": "number"
      }
    },
    "heading": {
      "size": {
        "$value": "{font.size.xl}",
        "$type": "dimension"
      },
      "weight": {
        "$value": "{font.weight.semibold}",
        "$type": "fontWeight"
      },
      "line-height": {
        "$value": "{font.line-height.tight}",
        "$type": "number"
      }
    },
    "label": {
      "size": {
        "$value": "{font.size.md}",
        "$type": "dimension"
      },
      "weight": {
        "$value": "{font.weight.medium}",
        "$type": "fontWeight"
      },
      "line-height": {
        "$value": "{font.line-height.tight}",
        "$type": "number"
      }
    }
  }
}
