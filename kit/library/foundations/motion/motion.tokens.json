        "$description": "Movement that stays on screen."
      },
      "enter": {
        "$value": [
          0,
          0,
          0,
          1
        ],
        "$description": "An element arrives: fast start, soft landing."
      },
      "exit": {
        "$value": [
          0.4,
          0,
          1,
          1
        ],
        "$description": "An element leaves: soft start, fast end."
      }
    }
