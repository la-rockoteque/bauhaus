{
  "color": {
    "$type": "color",
    "white": {
      "$value": "#ffffff"
    },
    "black": {
      "$value": "#000000"
    },
    "gray": {
      "50": {
        "$value": "#f9fafb"
      },
      "100": {
        "$value": "#f3f4f6"
      },
      "200": {
        "$value": "#e5e7eb"
      },
      "300": {
        "$value": "#d1d5db"
      },
      "400": {
        "$value": "#9ca3af"
      },
      "500": {
        "$value": "#6b7280"
      },
      "600": {
        "$value": "#4b5563"
      },
      "700": {
        "$value": "#374151"
      },
      "800": {
        "$value": "#1f2937"
      },
      "900": {
        "$value": "#111827"
      }
    },
    "blue": {
      "50": {
        "$value": "#eff6ff"
      },
      "200": {
        "$value": "#bfdbfe"
      },
      "300": {
        "$value": "#93c5fd"
      },
      "400": {
        "$value": "#60a5fa"
      },
      "600": {
        "$value": "#2563eb"
      },
      "700": {
        "$value": "#1d4ed8"
      },
      "800": {
        "$value": "#1e40af"
      },
      "900": {
        "$value": "#1e3a8a"
      }
    },
    "text": {
      "default": {
        "$value": "{color.gray.900}"
      },
      "muted": {
        "$value": "{color.gray.600}"
      },
      "disabled": {
        "$value": "{color.gray.400}"
      },
      "inverse": {
        "$value": "{color.white}"
      },
      "link": {
        "$value": "{color.blue.700}"
      },
      "on-accent": {
        "$value": "{color.white}"
      }
    },
    "surface": {
      "default": {
        "$value": "{color.white}"
      },
      "soft": {
        "$value": "{color.gray.50}"
      },
      "raised": {
        "$value": "{color.white}"
      },
      "sunken": {
        "$value": "{color.gray.100}"
      },
      "inverse": {
        "$value": "{color.gray.900}"
      }
    },
    "border": {
      "subtle": {
        "$value": "{color.gray.200}"
      },
      "default": {
        "$value": "{color.gray.300}"
      },
      "strong": {
        "$value": "{color.gray.500}"
      }
    },
    "accent": {
      "default": {
        "$value": "{color.blue.600}"
      },
      "hover": {
        "$value": "{color.blue.700}"
      },
      "active": {
        "$value": "{color.blue.800}"
      },
      "subtle": {
        "$value": "{color.blue.50}"
      }
    },
    "focus": {
      "ring": {
        "$value": "{color.accent.default}",
        "$description": "Outline colour of the focus indicator."
      }
    }
  }
}
