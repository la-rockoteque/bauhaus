    "$type": "shadow",
    "1": {
      "$value": {
        "color": "rgba(17, 24, 39, 0.10)",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "3px",
        "spread": "0px"
      }
    },
    "2": {
      "$value": [
        {
          "color": "rgba(17, 24, 39, 0.10)",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "6px",
          "spread": "-1px"
        },
        {
          "color": "rgba(17, 24, 39, 0.06)",
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "4px",
          "spread": "-2px"
        }
      ]
    }
