{
  "space": {
    "$type": "dimension",
    "$description": "4px grid, step n = n x 4px.",
    "0": {
      "$value": "0px"
    },
    "1": {
      "$value": "4px"
    },
    "2": {
      "$value": "8px"
    },
    "3": {
      "$value": "12px"
    },
    "4": {
      "$value": "16px"
    },
    "5": {
      "$value": "20px"
    },
    "6": {
      "$value": "24px"
    },
    "7": {
      "$value": "28px"
    },
    "8": {
      "$value": "32px"
    },
    "9": {
      "$value": "36px"
    },
    "10": {
      "$value": "40px"
    },
    "11": {
      "$value": "44px"
    },
    "12": {
      "$value": "48px"
    },
    "inset": {
      "xs": {
        "$value": "{space.1}"
      },
      "sm": {
        "$value": "{space.2}"
      },
      "md": {
        "$value": "{space.3}"
      },
      "lg": {
        "$value": "{space.4}"
      },
      "xl": {
        "$value": "{space.6}"
      }
    },
    "stack": {
      "xs": {
        "$value": "{space.1}"
      },
      "sm": {
        "$value": "{space.2}"
      },
      "md": {
        "$value": "{space.3}"
      },
      "lg": {
        "$value": "{space.4}"
      },
      "xl": {
        "$value": "{space.6}"
      }
    },
    "inline": {
      "xs": {
        "$value": "{space.1}"
      },
      "sm": {
        "$value": "{space.2}"
      },
      "md": {
        "$value": "{space.3}"
      },
      "lg": {
        "$value": "{space.4}"
      },
      "xl": {
        "$value": "{space.6}"
      }
    },
    "control": {
      "inline": {
        "$value": "{space.2}",
        "$description": "Horizontal padding inside a field or select."
      },
      "gap": {
        "$value": "{space.2}",
        "$description": "Gap between an icon and its label in a control."
      }
    },
    "field": {
      "gap": {
        "$value": "{space.1}",
        "$description": "Gap between label, hint, control and message of one field."
      }
    },
    "group": {
      "gap": {
        "$value": "{space.3}",
        "$description": "Gap between the fields of a form or the items of a group."
      }
    }
  },
  "size": {
    "$type": "dimension",
    "target": {
      "min": {
        "$value": "24px",
        "$description": "Smallest pointer target: WCAG 2.5.8 Target Size (Minimum) (AA). The house floor."
      }
    },
    "control": {
      "$description": "Visible heights of pressable and typeable controls. md is the default; none is below size.target.min.",
      "sm": {
        "$value": "{space.6}",
        "$description": "Dense rows inside a control, such as a tag or a toolbar toggle."
      },
      "md": {
        "$value": "{space.8}",
        "$description": "Default height of a button, field, tab, menu item or row."
      },
      "lg": {
        "$value": "{space.10}",
        "$description": "A single prominent call to action."
      }
    },
    "icon": {
      "$description": "Icon box sides.",
      "sm": {
        "$value": "{space.3}"
      },
      "md": {
        "$value": "{space.4}"
      },
      "lg": {
        "$value": "{space.5}"
      }
    },
    "border": {
      "$description": "Border widths.",
      "thin": {
        "$value": "1px",
        "$description": "Hairline of fields, cards and table rules."
      },
      "thick": {
        "$value": "{focus.ring.width}",
        "$description": "Emphasis border: selected card, focused field."
      }
    },
    "overlay": {
      "$description": "Maximum inline sizes of floating surfaces.",
      "sm": {
        "$value": "20rem",
        "$description": "Toast, tooltip, popover."
      },
      "md": {
        "$value": "30rem",
        "$description": "Menu, small dialog."
      },
      "lg": {
        "$value": "40rem",
        "$description": "Large dialog."
      }
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "$description": "Viewport widths where the layout changes. A custom property cannot sit in a media query, so a stylesheet writes the same number in @media (max-width) and an auto check holds the two equal.",
    "sm": {
      "$value": "640px",
      "$description": "Small screens: a phone in landscape and up."
    },
    "md": {
      "$value": "768px",
      "$description": "Medium screens: a tablet in portrait and up."
    },
    "lg": {
      "$value": "1024px",
      "$description": "Large screens: a tablet in landscape and up."
    }
  }
}
