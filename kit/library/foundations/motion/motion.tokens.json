  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "{duration.150}",
        "$description": "Hover and press feedback."
      },
      "base": {
        "$value": "{duration.200}",
        "$description": "Small enter and exit."
      },
      "deliberate": {
        "$value": "{duration.400}",
        "$description": "The ceiling (house.maxDurationMs). Also one turn of a spinner."
      }
    },
    "ease": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.2,
          0,
