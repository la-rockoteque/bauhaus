{
  "space": {
    "$type": "dimension",
    "inset": {
      "xs": {
        "$value": "{space.1}"
      },
      "sm": {
        "$value": "{space.2}"
      },
      "md": {
        "$value": "{space.4}"
      },
      "lg": {
        "$value": "{space.6}"
      },
      "xl": {
        "$value": "{space.8}"
      }
    },
    "stack": {
      "xs": {
        "$value": "{space.1}"
      },
      "sm": {
        "$value": "{space.2}"
      },
      "md": {
        "$value": "{space.4}"
      },
      "lg": {
        "$value": "{space.6}"
      },
      "xl": {
        "$value": "{space.10}"
      }
    },
    "inline": {
      "xs": {
        "$value": "{space.1}"
      },
      "sm": {
        "$value": "{space.2}"
      },
      "md": {
        "$value": "{space.3}"
      },
      "lg": {
        "$value": "{space.4}"
      },
      "xl": {
        "$value": "{space.6}"
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": {
        "$value": "{duration.50}"
      },
      "fast": {
        "$value": "{duration.150}"
      },
      "base": {
        "$value": "{duration.200}"
      },
      "slow": {
        "$value": "{duration.300}"
      },
      "deliberate": {
        "$value": "{duration.400}"
      }
    },
    "ease": {
      "$type": "cubicBezier",
      "standard": {
        "$value": "{easing.standard}"
      },
      "enter": {
        "$value": "{easing.enter}"
      },
      "exit": {
        "$value": "{easing.exit}"
      }
    }
  },
  "focus": {
    "ring": {
      "$description": "Focus indicator: 2px, 3:1 against adjacent colours (WCAG 1.4.11). The colour is the role focus.ring.color, defined per theme.",
      "width": {
        "$type": "dimension",
        "$value": "2px"
      },
      "offset": {
        "$type": "dimension",
        "$value": "2px"
      }
    }
  }
}
