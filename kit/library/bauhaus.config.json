{
  "$schema": "https://git.nexapptech.com/vbernier/bauhaus/bauhaus.config.schema.json",
  "name": "Acme Design System",
  "prefix": "ds",
  "tokens": {
    "source": "foundations",
    "themes": {
      "light": "themes/light",
      "dark": "themes/dark"
    },
    "defaultTheme": "light",
    "outputs": [
      {
        "format": "css",
        "path": "dist/tokens.css"
      },
      {
        "format": "ts",
        "path": "dist/tokens.ts"
      }
    ]
  },
  "components": ".",
  "storybook": {
    "config": ".storybook",
    "stories": "."
  },
  "rulebook": {
    "rules": "."
  },
  "stack": {
    "framework": "react",
    "styling": "css"
  },
  "house": {
    "contrast": "AA",
    "targetSize": 44
  }
}
