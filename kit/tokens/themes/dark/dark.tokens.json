{
  "text": {
    "$type": "color",
    "default": {
      "$value": "{colors.neutral.100}"
    },
    "muted": {
      "$value": "{colors.neutral.300}"
    },
    "inverse": {
      "$value": "{colors.neutral.900}"
    },
    "link": {
      "$value": "{colors.primary.300}"
    }
  },
  "surface": {
    "$type": "color",
    "default": {
      "$value": "{colors.neutral.800}"
    },
    "raised": {
      "$value": "{colors.neutral.700}"
    },
    "sunken": {
      "$value": "{colors.neutral.900}"
    }
  },
  "border": {
    "$type": "color",
    "default": {
      "$value": "{colors.neutral.600}"
    },
    "strong": {
      "$value": "{colors.neutral.400}"
    }
  },
  "action": {
    "$type": "color",
    "primary": {
      "$value": "{colors.primary.400}"
    },
    "primary-hover": {
      "$value": "{colors.primary.300}"
    },
    "primary-pressed": {
      "$value": "{colors.primary.200}"
    },
    "primary-text": {
      "$value": "{colors.neutral.900}"
    },
    "secondary": {
      "$value": "{colors.secondary.400}"
    },
    "secondary-hover": {
      "$value": "{colors.secondary.300}"
    },
    "secondary-pressed": {
      "$value": "{colors.secondary.200}"
    },
    "secondary-text": {
      "$value": "{colors.neutral.900}"
    },
    "danger": {
      "$value": "{colors.error.400}"
    },
    "danger-hover": {
      "$value": "{colors.error.300}"
    },
    "danger-pressed": {
      "$value": "{colors.error.200}"
    },
    "danger-text": {
      "$value": "{colors.neutral.900}"
    }
  },
  "status": {
    "$type": "color",
    "error": {
      "$value": "{colors.error.300}"
    },
    "error-surface": {
      "$value": "{colors.error.900}"
    },
    "success": {
      "$value": "{colors.success.300}"
    },
    "success-surface": {
      "$value": "{colors.success.900}"
    },
    "warning": {
      "$value": "{colors.warning.300}"
    },
    "warning-surface": {
      "$value": "{colors.warning.900}"
    },
    "info": {
      "$value": "{colors.info.300}"
    },
    "info-surface": {
      "$value": "{colors.info.900}"
    }
  },
  "focus": {
    "$type": "color",
    "ring": {
      "color": {
        "$value": "{colors.primary.300}"
      }
    }
  },
  "disabled": {
    "$type": "color",
    "text": {
      "$value": "{colors.neutral.500}"
    },
    "surface": {
      "$value": "{colors.neutral.700}"
    },
    "border": {
      "$value": "{colors.neutral.600}"
    }
  },
  "state": {
    "$type": "color",
    "hover-layer": {
      "$value": "{colors.primary.800}"
    },
    "pressed-layer": {
      "$value": "{colors.primary.700}"
    },
    "selected": {
      "$value": "{colors.primary.800}"
    }
  },
  "elevation": {
    "1": {
      "$value": "{shadow.dark.1}"
    },
    "2": {
      "$value": "{shadow.dark.2}"
    },
    "$type": "shadow"
  }
}
