      "$value": [
        0.2,
        0,
        0.38,
        0.9
      ]
    },
    "enter": {
      "$value": [
        0,
        0,
        0.38,
        0.9
      ]
    },
    "exit": {
      "$value": [
        0.2,
        0,
        1,
        0.9
      ]
    }
