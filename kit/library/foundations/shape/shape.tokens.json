{
  "radius": {
    "$type": "dimension",
    "none": {
      "$value": "0px"
    },
    "sm": {
      "$value": "2px"
    },
    "md": {
      "$value": "4px"
    },
    "lg": {
      "$value": "8px"
    },
    "full": {
      "$value": "9999px"
    },
    "control": {
      "$value": "{radius.md}",
      "$description": "Corner radius of buttons and fields."
    },
    "pill": {
      "$value": "{radius.full}",
      "$description": "Badge and tag."
    },
    "overlay": {
      "$value": "{radius.lg}",
      "$description": "Dialog, popover, menu, toast."
    }
  }
}
